<Window x:Class="EditorLicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EditorLicenseGenerator.ViewModels"
        mc:Ignorable="d"
        Title="010Editor License Generator" 
        Height="500" Width="550"
        MinHeight="450" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="010Editor License Generator" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#0078D4"/>
            <TextBlock Text="Generate Time, Version, or Trial licenses" 
                       FontSize="14" 
                       Foreground="#666666"
                       Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Tab Control -->
        <TabControl Grid.Row="1">
            
            <!-- Time License Tab -->
            <TabItem Header="Time License">
                <Grid Margin="20" DataContext="{Binding TimeLicense}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Generate a time-based license that expires after a specified number of days."
                               Foreground="#666666" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    
                    <Label Grid.Row="1" Content="User Name"/>
                    <TextBox Grid.Row="2" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"/>
                    
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <Label Content="Number of Users"/>
                            <TextBox Text="{Binding NumberOfUsers, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <Label Content="Days"/>
                            <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Grid.Row="4" Content="Generate License" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GenerateCommand}"
                            Margin="0,16,0,0"/>
                    
                    <StackPanel Grid.Row="5" Margin="0,16,0,0" 
                                Visibility="{Binding HasLicense, Converter={StaticResource BoolToVisibility}}">
                        <Label Content="Generated License"/>
                        <TextBox Text="{Binding GeneratedLicense, Mode=OneWay}" 
                                 Style="{StaticResource LicenseOutputStyle}"/>
                        
                        <Button Content="Copy to Clipboard" 
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyCommand}"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" 
                               Foreground="#107C10" 
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <!-- Version License Tab -->
            <TabItem Header="Version License">
                <Grid Margin="20" DataContext="{Binding VersionLicense}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Generate a version-specific license for a particular version of 010Editor."
                               Foreground="#666666" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    
                    <Label Grid.Row="1" Content="User Name"/>
                    <TextBox Grid.Row="2" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"/>
                    
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <Label Content="Number of Users"/>
                            <TextBox Text="{Binding NumberOfUsers, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <Label Content="Version"/>
                            <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Grid.Row="4" Content="Generate License" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GenerateCommand}"
                            Margin="0,16,0,0"/>
                    
                    <StackPanel Grid.Row="5" Margin="0,16,0,0" 
                                Visibility="{Binding HasLicense, Converter={StaticResource BoolToVisibility}}">
                        <Label Content="Generated License"/>
                        <TextBox Text="{Binding GeneratedLicense, Mode=OneWay}" 
                                 Style="{StaticResource LicenseOutputStyle}"/>
                        
                        <Button Content="Copy to Clipboard" 
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyCommand}"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" 
                               Foreground="#107C10" 
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <!-- Trial License Tab -->
            <TabItem Header="Trial License">
                <Grid Margin="20" DataContext="{Binding TrialLicense}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Generate a trial license (default 365 days)."
                               Foreground="#666666" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    
                    <Label Grid.Row="1" Content="User Name"/>
                    <TextBox Grid.Row="2" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"/>
                    
                    <Button Grid.Row="3" Content="Generate License" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GenerateCommand}"
                            Margin="0,16,0,0"/>
                    
                    <StackPanel Grid.Row="4" Margin="0,16,0,0" 
                                Visibility="{Binding HasLicense, Converter={StaticResource BoolToVisibility}}">
                        <Label Content="Generated License"/>
                        <TextBox Text="{Binding GeneratedLicense, Mode=OneWay}" 
                                 Style="{StaticResource LicenseOutputStyle}"/>
                        
                        <Button Content="Copy to Clipboard" 
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyCommand}"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" 
                               Foreground="#107C10" 
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </Grid>
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>
